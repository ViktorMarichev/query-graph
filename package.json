{
  "name": "@query-graph/core",
  "version": "1.1.1",
  "description": "Native query graph planner and SQL compiler for Node.js",
  "workspaces": [
    "packages/*"
  ],
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./definition": {
      "types": "./definition.d.ts",
      "require": "./definition.js",
      "default": "./definition.js"
    },
    "./dsl": {
      "types": "./dsl.d.ts",
      "require": "./dsl.js",
      "default": "./dsl.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViktorMarichev/query-graph.git"
  },
  "homepage": "https://github.com/ViktorMarichev/query-graph#readme",
  "bugs": {
    "url": "https://github.com/ViktorMarichev/query-graph/issues"
  },
  "keywords": [
    "query-graph",
    "sql",
    "napi-rs",
    "Rust",
    "N-API",
    "node-addon"
  ],
  "files": [
    "composition.js",
    "definition.d.ts",
    "definition.js",
    "dsl.d.ts",
    "dsl.js",
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "query-graph",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "node scripts/build-napi.mjs --release",
    "build:debug": "node scripts/build-napi.mjs",
    "check:versions": "node scripts/sync-version.mjs --check",
    "format": "run-p format:prettier format:rs format:toml",
    "format:generated": "prettier index.js index.d.ts --write",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "npm run check:versions && napi prepublish -t npm",
    "preversion": "npm run release:check",
    "release:check": "npm run build && npm run format:generated && npm run lint && npm run typecheck && npm test && prettier . --check && cargo fmt --all -- --check && cargo test --workspace --all-targets && cargo clippy --workspace --all-targets --all-features -- -D warnings && npm run check:versions",
    "typecheck": "tsc -p __test__/tsconfig.json --noEmit",
    "test": "ava",
    "version": "node scripts/sync-version.mjs && npm run build && npm run format:generated && node scripts/sync-version.mjs --check && git add package.json packages/dsl-object/package.json yarn.lock Cargo.toml crates/query-graph-core/Cargo.toml Cargo.lock index.js index.d.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@oxc-node/core": "^0.1.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "ava": "^7.0.0",
    "chalk": "^5.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "tinybench": "^6.0.0",
    "typescript": "^6.0.0"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "yarn@4.13.0"
}
